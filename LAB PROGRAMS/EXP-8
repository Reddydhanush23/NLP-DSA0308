tag_probabilities = {
    "book": {"NN": 0.7, "VB": 0.3},
    "can": {"MD": 0.6, "VB": 0.4},
    "runs": {"VBZ": 0.8, "NNS": 0.2},
    "the": {"DT": 1.0},
    "dog": {"NN": 1.0},
    "quickly": {"RB": 1.0}
}
sentence = "The dog runs quickly".lower().split()
print("\nStochastic POS Tags:")
for word in sentence:
    probabilities = tag_probabilities.get(word)
    if probabilities:
        best_tag = max(probabilities, key=probabilities.get)
    else:
        best_tag = "NN"
    print(f"{word:15} {best_tag}")
