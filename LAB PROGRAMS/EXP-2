def accepts_ending_ab(text):
    state = "q0"
    for ch in text:
        if ch not in ("a", "b"):
            return False
        if state == "q0":
            state = "q1" if ch == "a" else "q0"
        elif state == "q1":
            state = "q1" if ch == "a" else "q2"
        else:
            state = "q1" if ch == "a" else "q0"
    return state == "q2"
word = "aabab"
if accepts_ending_ab(word):
    print("Accepted: the string ends with 'ab'.")
else:
    print("Rejected: the string does not end with 'ab'.")
