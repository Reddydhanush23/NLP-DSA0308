import re
text = "The boy is playing cricket in the playground."
pattern = "playing"
matches = re.findall(pattern, text, flags=re.IGNORECASE)
if matches:
    print("Pattern found!")
    print("Matches:", matches)
else:
    print("Pattern not found.")
if re.search(pattern, text, flags=re.IGNORECASE):
    print("Search result: Match exists in the sentence.")
