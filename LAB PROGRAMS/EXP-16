import spacy

nlp = spacy.load("en_core_web_sm")

text = "Sundar Pichai works at Google in California."

doc = nlp(text)

print("Input Text:", text)
print("\nNamed Entities:")

if doc.ents:
    for ent in doc.ents:
        print(ent.text, ":", ent.label_)
else:
    print("No named entities found.")
